# Скопируйте в web/.env.local и подставьте значения из Firebase:
# Project settings → General → Your apps → ваше веб-приложение → Config.
# Значения не секретны (доступ защищают firestore.rules), но в git .env.local не попадает.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=university-schedule-hw.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=university-schedule-hw
VITE_FIREBASE_APP_ID=

# База называется "default" (без скобок), менять не нужно.
VITE_FIRESTORE_DATABASE=default

# Только для разработки: 1 = демо без Firebase (данные в памяти, вход не нужен).
# VITE_DEMO=1
